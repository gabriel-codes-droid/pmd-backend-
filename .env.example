# PMD backend - copy to .env (dev) or set in Render dashboard (prod)

# Server
PORT=8000
NODE_ENV=development

# Database - replace with your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/pmd

# Auth - replace with a long random string in production
# Example: openssl rand -hex 32 (paste the output here)
JWT_SECRET=pmd-super-secret-jwt-key-for-production-use-min-32-chars
JWT_EXPIRES_IN=7d

# Admin credentials (for seeding admin user)
ADMIN_USERNAME=Admin
ADMIN_EMAIL=admin@pmd.local
ADMIN_PASSWORD=Admin@12345

# Comma-separated list of frontend origins allowed to call the API
# dev:  http://localhost:5173,http://localhost:3000
# prod: https://your-pmd-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# ---- Email (Resend) ----
# Sign up at https://resend.com and get an API key
# Free tier: 100 emails/day, no credit card needed
EMAIL_SERVICE=resend
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev
